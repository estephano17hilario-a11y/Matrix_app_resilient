<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================ -->
    <!--  PERMISOS PRINCIPALES                                        -->
    <!-- ============================================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- ============================================================ -->
    <!--  ELIMINAR AD_ID: Evita que cualquier plugin o dependencia    -->
    <!--  (Firebase, RevenueCat, etc.) inyecte este permiso.         -->
    <!--  Esta app NO usa anuncios ni AdMob.                         -->
    <!-- ============================================================ -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
                     tools:node="remove"/>

    <!-- ============================================================ -->
    <!--  QUERIES: Aplicaciones externas que puede abrir la app      -->
    <!-- ============================================================ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.mercadopago.android.app" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- Main Activity -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep Link: luxapp:// para OAuth de Supabase -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>
            <!-- Deep Link: com.luxresilient.app://auth/callback para OAuth de Supabase -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.luxresilient.app" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ============================================================ -->
        <!--  FOREGROUND SERVICE - Standard (sin specialUse)             -->
        <!--  Mantiene el temporizador de sesiones de enfoque activo.    -->
        <!-- ============================================================ -->
        <service
            android:name=".FocusService"
            android:enabled="true"
            android:exported="false" />

        <!-- Widget Settings/Configuration Activity -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Widget Translucent Action/Dialog Activity -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Widget Receiver -->
        <receiver
            android:name=".widget.HabitWidgetProvider"
            android:exported="true"
            android:label="@string/widget_habits_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.luxresilient.app.COMPLETE_HABIT" />
                <action android:name="com.luxresilient.app.TOGGLE_SUBTASK" />
                <action android:name="com.luxresilient.app.INCREMENT_QUANTITY" />
                <action android:name="com.luxresilient.app.REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!-- Widget ListView RemoteViews Service -->
        <service
            android:name=".widget.HabitWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
            
        <!-- Task Widget Receiver -->
        <receiver
            android:name=".widget.TaskWidgetProvider"
            android:exported="true"
            android:label="Matrix Quests">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.luxresilient.app.COMPLETE_TASK" />
                <action android:name="com.luxresilient.app.REFRESH_TASKS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- Task Widget ListView Service -->
        <service
            android:name=".widget.TaskWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Focus Graph Widget Receiver -->
        <receiver
            android:name=".widget.FocusWidgetProvider"
            android:exported="true"
            android:label="Matrix Enfoque">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.luxresilient.app.CYCLE_FOCUS_TIMEFRAME" />
                <action android:name="com.luxresilient.app.CYCLE_FOCUS_DIVISION" />
                <action android:name="com.luxresilient.app.REFRESH_FOCUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!-- Project Progress Widget Receiver -->
        <receiver
            android:name=".widget.ProjectWidgetProvider"
            android:exported="true"
            android:label="Matrix Progreso Proyecto">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.luxresilient.app.REFRESH_PROJECT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/project_widget_info" />
        </receiver>


        <!-- Google Play Services version -->
        <meta-data android:name="com.google.android.gms.version" android:value="@integer/google_play_services_version" />

    </application>

</manifest>
