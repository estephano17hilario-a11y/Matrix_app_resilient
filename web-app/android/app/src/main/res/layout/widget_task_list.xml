<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/task_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/task_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="QUESTS"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
                
            <!-- Add Quest Button -->
            <FrameLayout
                android:id="@+id/btn_add_quest"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </FrameLayout>

            <!-- Toggle Completed Quests Button -->
            <FrameLayout
                android:id="@+id/task_widget_completed_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_toStartOf="@id/btn_add_quest"
                android:layout_marginEnd="6dp"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true">
                <TextView
                    android:id="@+id/task_widget_completed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👁️"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Cycle Timeframe Button -->
            <FrameLayout
                android:id="@+id/task_widget_timeframe_btn"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_toStartOf="@id/task_widget_completed_btn"
                android:layout_marginEnd="6dp"
                android:layout_centerVertical="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true">
                <TextView
                    android:id="@+id/task_widget_timeframe_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="TODO"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp" />
            </FrameLayout>

        </RelativeLayout>


    <!-- Task List -->
    <ListView
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:clipToPadding="false" />

    <!-- Empty View -->
    <TextView
        android:id="@+id/task_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No hay Quests activas hoy."
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

</LinearLayout>
</FrameLayout>
