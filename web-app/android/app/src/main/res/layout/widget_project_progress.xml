<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Overall background image -->
    <ImageView
        android:id="@+id/project_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!-- Unconfigured State -->
    <LinearLayout
        android:id="@+id/project_unconfigured_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_select_project"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona el proyecto"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#26FFFFFF"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Configured State -->
    <RelativeLayout
        android:id="@+id/project_configured_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:visibility="visible">

        <!-- Custom Glow/Gradient Card Background -->
        <ImageView
            android:id="@+id/project_glow_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left: Play Button Frame -->
            <FrameLayout
                android:id="@+id/project_play_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/project_play_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />

            </FrameLayout>

            <!-- Middle: Title, Details, Progress Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title & Time Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/project_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Proyecto X"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/project_time_fraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A0A0A0"
                        android:textSize="11sp"
                        android:text="0h 00m / 1h 10m" />

                </LinearLayout>

                <!-- Progress Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent">

                        <ImageView
                            android:id="@+id/project_progress_bar_fill"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/project_percentage_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A0A0A0"
                        android:textSize="10sp"
                        android:layout_marginStart="8dp"
                        android:text="0%" />

                </LinearLayout>

            </LinearLayout>

            <!-- Far Right: Chevron Icon -->
            <TextView
                android:id="@+id/project_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#4DFFFFFF"
                android:textSize="16sp"
                android:text="›" />

        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
