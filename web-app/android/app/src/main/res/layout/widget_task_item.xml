<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_item_root_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/task_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <!-- Card Background -->
        <ImageView
            android:id="@+id/task_card_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_habit_item_bg" />

        <!-- Glow/Gradient Background -->
        <ImageView
            android:id="@+id/task_glow_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <RelativeLayout
            android:id="@+id/task_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">

            <!-- Checkbox Button (Left) -->
            <FrameLayout
                android:id="@+id/task_complete_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_icon_container_bg">

                <ImageView
                    android:id="@+id/task_check_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/task_check_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                    
                <TextView
                    android:id="@+id/task_type_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎯"
                    android:textSize="18sp" />
            </FrameLayout>

            <!-- Center: Title + Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/task_complete_btn"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Quest Title" />

                <!-- Row for Badges (Difficulty, XP, Gold, Deadline) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <!-- Difficulty Badge -->
                    <TextView
                        android:id="@+id/task_difficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_streak_badge_bg"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginEnd="6dp"
                        android:text="S" />

                    <!-- XP Badge -->
                    <TextView
                        android:id="@+id/task_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#10b981"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        android:text="+50 XP" />

                    <!-- Gold Badge -->
                    <TextView
                        android:id="@+id/task_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#f59e0b"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        android:text="+20 Gold" />
                        
                    <!-- Deadline -->
                    <TextView
                        android:id="@+id/task_deadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#f43f5e"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:text="Hoy" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>
