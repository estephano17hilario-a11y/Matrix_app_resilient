<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selector_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/widget_habit_item_bg"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/selector_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Opción"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Options Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="320dp">

            <LinearLayout
                android:id="@+id/selector_options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Cancel Button -->
        <Button
            android:id="@+id/selector_cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="Cancelar"
            android:textColor="#A0A0A0"
            android:backgroundTint="#00FFFFFF"
            android:textAllCaps="false"
            android:textSize="12sp" />

    </LinearLayout>
</FrameLayout>
