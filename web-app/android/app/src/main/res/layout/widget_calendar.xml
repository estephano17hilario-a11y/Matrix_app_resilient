<?xml version="1.0" encoding="utf-8"?>
<!-- Lux · Calendario: Google-Calendar style time grid of the routine (day / 3 days / week), drawn as one bitmap under a small control header. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/calendar_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Header: what you are looking at + navigation -->
        <LinearLayout
            android:id="@+id/calendar_header"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/calendar_title_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/calendar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Calendario"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/calendar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/calendar_today_btn"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_routine_pill_bg"
                android:clickable="true"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="HOY"
                    android:textColor="#7DD3FC"
                    android:textSize="9.5sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/calendar_span_btn"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_routine_pill_bg"
                android:clickable="true"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <TextView
                    android:id="@+id/calendar_span_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="DÍA"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/calendar_prev_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/calendar_next_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_next" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tools row (hidden until the sliders button is tapped): zoom and the colour of the blocks -->
        <LinearLayout
            android:id="@+id/calendar_tools_row"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/calendar_zoom_out_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_minus" />
            </FrameLayout>

            <TextView
                android:id="@+id/calendar_zoom_text"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_routine_pill_bg"
                android:clickable="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp" />

            <FrameLayout
                android:id="@+id/calendar_zoom_in_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_plus" />
            </FrameLayout>

            <!-- Segmented control: colour by my colour / trait / importance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_routine_pill_bg"
                android:orientation="horizontal"
                android:padding="2dp">

                <FrameLayout
                    android:id="@+id/calendar_color_own"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_calendar_chip_on"
                    android:clickable="true">

                    <TextView
                        android:id="@+id/calendar_color_own_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="MÍO"
                        android:textColor="#FFFFFF"
                        android:textSize="8.5sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/calendar_color_trait"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_calendar_chip_off"
                    android:clickable="true">

                    <TextView
                        android:id="@+id/calendar_color_trait_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="RASGO"
                        android:textColor="#99FFFFFF"
                        android:textSize="8.5sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/calendar_color_importance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.25"
                    android:background="@drawable/widget_calendar_chip_off"
                    android:clickable="true">

                    <TextView
                        android:id="@+id/calendar_color_importance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="IMPORT."
                        android:textColor="#99FFFFFF"
                        android:textSize="8.5sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The calendar itself (one bitmap) with scroll buttons floating on its right edge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/calendar_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:scaleType="fitXY" />

            <!-- Tap areas of the blocks: placed over the bitmap at run time (Android 12+) -->
            <FrameLayout
                android:id="@+id/calendar_hit_0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_10"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_11"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_12"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_13"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_14"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/calendar_hit_15"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:visibility="gone" />

            <!-- View settings: opens the tools row (zoom, colours) -->
            <FrameLayout
                android:id="@+id/calendar_tools_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_tune" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/calendar_up_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="32dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_up" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/calendar_down_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="2dp"
                android:background="@drawable/widget_routine_btn_bg"
                android:clickable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar_down" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
