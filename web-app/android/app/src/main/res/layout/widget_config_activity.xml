<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020204"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/config_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de Widget"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/config_title"
            android:text="Personaliza la apariencia y el comportamiento"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Layout Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMAÑO DE TARJETA"
                android:textColor="#6366f1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/config_size_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:background="#0DFFFFFF"
                android:padding="4dp"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/config_size_thin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delgado"
                    android:textColor="#E0E0E0"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@android:color/transparent" />

                <RadioButton
                    android:id="@+id/config_size_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mediano"
                    android:textColor="#E0E0E0"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@android:color/transparent"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grande"
                    android:textColor="#E0E0E0"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@android:color/transparent" />

            </RadioGroup>

            <!-- Card Opacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPACIDAD DEL FONDO"
                android:textColor="#6366f1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <SeekBar
                    android:id="@+id/config_opacity_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="90" />

                <TextView
                    android:id="@+id/config_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90%"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Glow Effect Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/glow_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efecto de Resplandor (Glow)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/glow_title"
                    android:text="Agrega luces difuminadas con el color del hábito"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <Switch
                    android:id="@+id/config_glow_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

            <!-- Checklist View Option -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÉTODO PARA SUBTAREAS"
                android:textColor="#6366f1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/config_checklist_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:background="#0DFFFFFF"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/config_checklist_direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar directamente en widget"
                    android:textColor="#E0E0E0"
                    android:padding="10dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_checklist_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Abrir diálogo flotante intercativo"
                    android:textColor="#E0E0E0"
                    android:padding="10dp" />

            </RadioGroup>

            <!-- Sound Effects Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/sound_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efectos de Sonido"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/sound_title"
                    android:text="Reproduce sonidos al interactuar con el widget"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <Switch
                    android:id="@+id/config_sound_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/config_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="#E0E0E0"
            android:backgroundTint="#26FFFFFF"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/config_save_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Guardar Cambios"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6366f1"
            android:layout_marginStart="8dp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
