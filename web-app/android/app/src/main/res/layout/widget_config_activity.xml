<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0A0E"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/config_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de Widget"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/config_title"
            android:text="Personaliza la apariencia y el comportamiento"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="1dp" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Size Setting -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMAÑO DE TARJETA"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_size_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/config_size_super_thin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="S.Delgado"
                    android:textColor="#E0E0E0"
                    android:textSize="10sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/config_size_thin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delgado"
                    android:textColor="#E0E0E0"
                    android:textSize="10sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/config_size_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mediano"
                    android:textColor="#E0E0E0"
                    android:textSize="10sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grande"
                    android:textColor="#E0E0E0"
                    android:textSize="10sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

            </RadioGroup>

            <!-- Card Layout Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTRIBUCIÓN DE HÁBITOS"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_columns_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/config_cols_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1 Columna (Lista)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_cols_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2 Columnas (Cuadrícula)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

            </RadioGroup>

            <!-- Chrono Card Layout Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTRIBUCIÓN EN MODO CRONOLÓGICO"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_chrono_columns_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/config_chrono_cols_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1 Columna (Lista)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_chrono_cols_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2 Columnas (Cuadrícula)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

            </RadioGroup>

            <!-- Card Spacing Setting -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESPACIO ENTRE TARJETAS"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_spacing_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/config_spacing_poco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Poco (Pegados)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/config_spacing_medio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medio"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_spacing_grande"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grande"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="8dp" />

            </RadioGroup>

            <!-- Background Opacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPACIDAD DEL FONDO"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <SeekBar
                    android:id="@+id/config_opacity_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="90" />

                <TextView
                    android:id="@+id/config_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90%"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Overall Widget Background Opacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPACIDAD DEL FONDO DEL WIDGET"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <SeekBar
                    android:id="@+id/config_widget_bg_opacity_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="85" />

                <TextView
                    android:id="@+id/config_widget_bg_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Gradient Style Option -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTILO DE DEGRADADO (TINTE)"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_gradient_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="6dp">

                <RadioButton
                    android:id="@+id/config_grad_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ninguno (Color plano con opacidad)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_grad_radial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resplandor Radial (Centro / Izquierda)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_grad_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Degradado Completo (Abajo hacia arriba)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_grad_center_radial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resplandor Central (Desde el medio hacia afuera)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

            </RadioGroup>

            <!-- Border Style Option -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BORDES DE COLOR DEL HÁBITO"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_border_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="6dp">

                <RadioButton
                    android:id="@+id/config_border_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ninguno"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Borde de la tarjeta del hábito"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_border_circle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Borde del círculo del completado"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_border_both"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ambos (Borde de tarjeta y de círculo)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:checked="true" />

            </RadioGroup>

            <!-- Checklist View Option -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÉTODO PARA SUBTAREAS"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_checklist_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="6dp">

                <RadioButton
                    android:id="@+id/config_checklist_direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar directamente en widget"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/config_checklist_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Abrir diálogo flotante interactivo"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:padding="6dp" />

            </RadioGroup>

            <!-- Show Icons Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/icons_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mostrar Íconos"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/icons_title"
                    android:text="Muestra o oculta los emojis de los hábitos"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/config_icons_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

            <!-- Chronological View Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/chrono_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Botón de Modo Cronológico"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/chrono_title"
                    android:text="Muestra el botón en el widget para alternar vistas"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/config_allow_chrono_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

            <!-- Bad Habits Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/bad_habit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Botón de Malos Hábitos"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bad_habit_title"
                    android:text="Muestra el botón para alternar a Malos Hábitos"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/config_allow_bad_habits_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

            <!-- Time Format 12h Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/time_format_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formato de Hora (12h)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/time_format_title"
                    android:text="Usa el formato AM/PM en vez de 24 horas"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/config_time_format_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="false" />

            </RelativeLayout>

            <!-- Sound Effects Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/sound_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efectos de Sonido"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/sound_title"
                    android:text="Sonidos al interactuar con el widget"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/config_sound_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />

            </RelativeLayout>

            <!-- Default Task Timeframe Setting -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTRO DE TIEMPO POR DEFECTO PARA TAREAS"
                android:textColor="#6366f1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/config_task_timeframe_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="#0DFFFFFF"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/config_timeframe_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todas las tareas (Sin límite)"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Diarias"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semanales"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_month"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mensuales"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_8weeks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Próximas 8 semanas"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_3months"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Próximos 3 meses"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

                <RadioButton
                    android:id="@+id/config_timeframe_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Anuales"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:padding="6dp" />

            </RadioGroup>

            <!-- Project Selection Section (Project Widget Only) -->
            <LinearLayout
                android:id="@+id/config_project_select_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECCIONAR PROYECTO"
                    android:textColor="#6366f1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/config_project_select_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:background="#0DFFFFFF"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>



    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/config_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="#E0E0E0"
            android:backgroundTint="#26FFFFFF"
            android:layout_marginEnd="6dp"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/config_save_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6366f1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
