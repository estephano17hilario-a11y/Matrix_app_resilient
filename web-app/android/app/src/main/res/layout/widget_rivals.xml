<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rivals_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:padding="8dp">

    <!-- 1x1 COMPACT LAYOUT -->
    <LinearLayout
        android:id="@+id/rivals_layout_1x1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Duel Avatars side-by-side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="🛡️"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text="⚔️"
                android:textColor="#FFB703"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rival_avatar_1x1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="⌛"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rival_name_1x1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rival"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rivals_stats_1x1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="T: 0 v 0"
            android:textColor="#60A5FA"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rivals_status_1x1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="⚔️ Duelo"
            android:textColor="#F59E0B"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2x1 HORIZONTAL LAYOUT -->
    <LinearLayout
        android:id="@+id/rivals_layout_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rival_avatar_horiz"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_avatar_bg"
            android:gravity="center"
            android:text="⌛"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/rival_name_horiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Francesco Cirillo"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rival_activity_horiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🔴 En Enfoque Profundo"
                android:textColor="#F59E0B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rivals_stats_horiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T: 0 v 0 | F: 0h v 0h"
                android:textColor="#60A5FA"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rivals_status_horiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="⚔️ DUELO"
                android:textColor="#F59E0B"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- FULL 2x2+ GRID LAYOUT (Frosted Duel Arena UI) -->
    <LinearLayout
        android:id="@+id/rivals_layout_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="visible">

        <!-- Header: Title and activity status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔️ DUELO MATRIZ"
                android:textColor="#FFB703"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/rival_level_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_glass_bg"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="Lvl 1"
                android:textColor="#FFB703"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Activity status description -->
        <TextView
            android:id="@+id/rival_activity_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🔴 En Enfoque Profundo"
            android:textColor="#80FFFFFF"
            android:textSize="8sp"
            android:layout_marginTop="1dp" />

        <!-- Divider line -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:background="#15FFFFFF" />

        <!-- SPLIT VS DUEL LAYOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="10">

            <!-- LEFT COLUMN: TÚ (PLAYER) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_avatar_bg"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tú"
                    android:textColor="#A0FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <!-- User Stats -->
                <TextView
                    android:id="@+id/user_tasks_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/user_focus_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0h"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/user_habits_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MIDDLE COLUMN: VS & LABELS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_refresh_bg"
                    android:gravity="center"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="VS"
                    android:textColor="#FFB703"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Tareas"
                    android:textColor="#50FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foco"
                    android:textColor="#50FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hábitos"
                    android:textColor="#50FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RIGHT COLUMN: RIVAL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rival_avatar_text"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_avatar_bg"
                    android:gravity="center"
                    android:text="⌛"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/rival_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Francesco Cirillo"
                    android:textColor="#A0FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <!-- Rival Stats -->
                <TextView
                    android:id="@+id/rival_tasks_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rival_focus_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0h"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rival_habits_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dueling Status Banner -->
        <TextView
            android:id="@+id/rivals_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="#15FFFFFF"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="⚔️ DUELO EN CURSO"
            android:textColor="#F59E0B"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
