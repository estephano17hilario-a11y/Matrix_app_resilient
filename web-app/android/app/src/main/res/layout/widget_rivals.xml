<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rivals_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:padding="12dp">

    {/* Main Container */}
    <LinearLayout
        android:id="@+id/rivals_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        {/* Rival Info Header */}
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            {/* Avatar Circle */}
            <TextView
                android:id="@+id/rival_avatar_text"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_avatar_bg"
                android:gravity="center"
                android:text="⌛"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/rival_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Francesco Cirillo"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/rival_activity_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 En Enfoque Profundo"
                    android:textColor="#F59E0B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            {/* Level Badge */}
            <TextView
                android:id="@+id/rival_level_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_glass_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Lvl 1"
                android:textColor="#FFB703"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        {/* Horizontal Divider Line */}
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginVertical="4dp" />

        {/* Live Comparison Stats Row */}
        <LinearLayout
            android:id="@+id/rivals_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingTop="4dp">

            {/* Tareas Stat */}
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAREAS"
                    android:textColor="#94A3B8"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rivals_tasks_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 1"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            {/* Focus Stat */}
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCO"
                    android:textColor="#94A3B8"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rivals_focus_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h / 1h"
                    android:textColor="#C084FC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            {/* Habits Stat */}
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HÁBITOS"
                    android:textColor="#94A3B8"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rivals_habits_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% / 25%"
                    android:textColor="#FB923C"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        {/* Victory Status Banner */}
        <TextView
            android:id="@+id/rivals_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1DF59E0B"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="⚔️ DUELO EN CURSO"
            android:textColor="#F59E0B"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
