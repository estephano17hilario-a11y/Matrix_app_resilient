<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_score_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Themed glass card -->
    <ImageView
        android:id="@+id/score_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!-- Locked state -->
    <LinearLayout
        android:id="@+id/score_login_required"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Abre Lux"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/score_configured_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- SQUARE / TALL: ring that scales to the space, label on top, flipping caption below -->
        <LinearLayout
            android:id="@+id/score_layout_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/score_widget_title_vert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:text="HOY"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/score_ring_vert"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/score_widget_value_vert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />
            </FrameLayout>

            <ViewFlipper
                android:id="@+id/score_flipper_vert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoStart="true"
                android:flipInterval="3800"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out">

                <TextView
                    android:id="@+id/score_widget_sub_vert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Rendimiento diario"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/score_widget_caption_vert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Tareas · Hábitos · Foco"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
            </ViewFlipper>
        </LinearLayout>

        <!-- WIDE: ring left, label + message + mini bar right -->
        <LinearLayout
            android:id="@+id/score_layout_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="58dp">

                <ImageView
                    android:id="@+id/score_ring_horiz"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/score_widget_value_horiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/score_widget_title_horiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:maxLines="1"
                    android:text="HOY"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/score_widget_sub_horiz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="Rendimiento"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/score_bar_horiz"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="7dp"
                    android:scaleType="fitXY" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
