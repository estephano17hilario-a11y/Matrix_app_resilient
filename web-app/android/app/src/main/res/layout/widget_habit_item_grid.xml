<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_item_root_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/habit_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Card Background (to dynamically set opacity) -->
        <ImageView
            android:id="@+id/habit_card_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_habit_item_bg" />

        <!-- Dynamic Glow/Gradient Background rendered dynamically in code -->
        <ImageView
            android:id="@+id/habit_glow_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- Color Overlay (tinted background - set programmatically) -->
        <FrameLayout
            android:id="@+id/habit_color_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.09" />

        <!-- Left: Emoji icon directly without background container to save space -->
        <TextView
            android:id="@+id/habit_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textSize="14sp"
            android:layout_marginStart="2dp"
            android:text="🎯" />

        <!-- Center: Title + Progress -->
        <LinearLayout
            android:id="@+id/habit_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/habit_icon"
            android:layout_toStartOf="@id/habit_action_container"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <!-- Title Row: Name -->
            <TextView
                android:id="@+id/habit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Habit Title" />

            <!-- Progress Text -->
            <TextView
                android:id="@+id/habit_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:text="0/1" />

        </LinearLayout>

        <!-- Right: Complete Button (Smaller for Grid) -->
        <LinearLayout
            android:id="@+id/habit_action_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/habit_complete_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/habit_complete_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <!-- Check Icon (hidden) -->
                <TextView
                    android:id="@+id/habit_check_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Hidden container wrappers to keep Kotlin ID lookups safe from crashes -->
        <FrameLayout
            android:id="@+id/habit_icon_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/habit_streak_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <TextView android:id="@+id/habit_streak_count" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habit_subtasks_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </RelativeLayout>
</LinearLayout>
