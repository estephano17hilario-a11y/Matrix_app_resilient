<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Overall Widget Background Image (for dynamic opacity) -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <!-- Header: Logo + Title + Settings -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <!-- App Title -->
            <LinearLayout
                android:id="@+id/widget_header_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_header_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="16sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protocolos"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/widget_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#4DFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Settings Button -->
            <FrameLayout
                android:id="@+id/widget_settings_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚙️"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Eye Filter Button -->
            <FrameLayout
                android:id="@+id/widget_filter_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_toStartOf="@id/widget_settings_btn"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/widget_filter_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👁️"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Chronological Toggle Button -->
            <FrameLayout
                android:id="@+id/widget_chrono_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_toStartOf="@id/widget_filter_btn"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_chrono_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚡"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Bad Habits Toggle Button -->
            <FrameLayout
                android:id="@+id/widget_bad_habit_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_toStartOf="@id/widget_chrono_btn"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_refresh_bg"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_bad_habit_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🚫"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>

        </RelativeLayout>

        <!-- Habit List -->
        <ListView
            android:id="@+id/widget_habit_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:fadingEdge="none"
            
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <!-- Empty View -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✨ ¡Todo completado!"
            android:textColor="#4DFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- Unused GridView definition to maintain ID layout mapping safety in Android -->
        <GridView
            android:id="@+id/widget_habit_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
