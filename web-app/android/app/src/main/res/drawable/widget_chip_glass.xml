<?xml version="1.0" encoding="utf-8"?>
<!-- Raised glass chip (counterpart of widget_chip_dark). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2EFFFFFF"
        android:endColor="#14FFFFFF"
        android:type="linear" />
    <corners android:radius="13dp" />
    <stroke android:width="0.5dp" android:color="#2EFFFFFF" />
</shape>
