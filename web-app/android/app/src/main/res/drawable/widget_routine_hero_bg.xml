<?xml version="1.0" encoding="utf-8"?>
<!-- Hero strip of the Routine widget: same sky -> indigo -> violet wash as the app's Routine hero. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#2938BDF8"
        android:centerColor="#246366F1"
        android:endColor="#2AA855F7"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
