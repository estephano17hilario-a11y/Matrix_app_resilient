rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- SECURITY KERNEL (BANK-GRADE) ---
    
    // 1. AUTHENTICATION GATES
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 2. DATA INTEGRITY GATES (TYPE VALIDATION)
    function isValidString(data, field, maxLen) {
      return data.get(field, '') is string && data.get(field, '').size() <= maxLen;
    }
    
    function isValidNumber(data, field) {
      return data.get(field, 0) is number;
    }
    
    function isValidBoolean(data, field) {
      return data.get(field, false) is bool;
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // 3. IMMUTABILITY GATES (SOFT DELETE ENFORCEMENT)
    // CRITICAL: Physical deletion is FORBIDDEN. Only 'deleted' flag updates allowed.
    function isNotPhysicalDelete() {
      return request.method != 'delete';
    }

    // --- COLLECTION RULES ---

    // USER DATA (Root)
    // Strict ownership: Users can ONLY touch their own doc.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidString(request.resource.data, 'email', 100)
        && isValidString(request.resource.data, 'displayName', 50);
      allow update: if isOwner(userId) && isNotPhysicalDelete();
      allow delete: if false; // NEVER ALLOW PHYSICAL DELETE

      // SUBCOLLECTIONS (Recursive Protection)
      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isNotPhysicalDelete();
      }
    }
    
    // AUDIT LOGS (Write-Only / Append-Only)
    // Users can create logs for their actions, but NEVER read or modify them.
    match /audit_logs/{logId} {
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // GLOBAL BLACKHOLE
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
