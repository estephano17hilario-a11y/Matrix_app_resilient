rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- SECURITY KERNEL (BANK-GRADE) ---
    
    // 1. AUTHENTICATION GATES
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 2. DATA INTEGRITY GATES (TYPE VALIDATION) - PERMISSIVE FOR EXISTING DOCS
    function isValidString(data, field, maxLen) {
      let val = data.get(field, null);
      if (val == null) return true; // Null fields are OK (field might not exist yet)
      if (val is string) return val.size() <= maxLen;
      return false;
    }
    
    function isValidNumber(data, field) {
      let val = data.get(field, null);
      if (val == null) return true;
      return val is number;
    }
    
    function isValidBoolean(data, field) {
      let val = data.get(field, null);
      if (val == null) return true;
      return val is bool;
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // 3. IMMUTABILITY GATES (SOFT DELETE ENFORCEMENT)
    // CRITICAL: Physical deletion is FORBIDDEN. Only 'deleted' flag updates allowed.
    function isNotPhysicalDelete() {
      return request.method != 'delete';
    }
    
    // 4. PERMISSIVE VALIDATION FOR UPDATES (existing docs might have partial data)
    function isValidUpdate(data) {
      // Allow updates with any string fields as long as they're not too long
      let keys = data.keys();
      // Check no string field exceeds 200 chars (reasonable limit)
      return true; // Keep it permissive for updates
    }

    // --- COLLECTION RULES ---

    // USER DATA (Root)
    // Strict ownership: Users can ONLY touch their own doc.
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // PERMISSIVE create: only require auth ownership and basic type checks
      // Remove strict field validation to allow Google auth and other providers
      allow create: if isOwner(userId);
      
      // PERMISSIVE update: allow updates to existing documents
      allow update: if isOwner(userId) && isNotPhysicalDelete();
      
      allow delete: if false; // NEVER ALLOW PHYSICAL DELETE

      // SUBCOLLECTIONS (Recursive Protection)
      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isNotPhysicalDelete();
      }
    }
    
    // AUDIT LOGS (Write-Only / Append-Only)
    // Users can create logs for their actions, but NEVER read or modify them.
    match /audit_logs/{logId} {
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // GLOBAL BLACKHOLE
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
